# Copy to .env and adjust as needed. .env is gitignored.

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- Storage paths (relative to repo root) ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=policies
SQLITE_PATH=./data/memory.sqlite

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
UI_API_URL=http://localhost:8000

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=5

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Observability (Phase 5) ---
# Default config below targets OpenObserve as a native WSL binary (no Docker).
# Spin it up with:
#   bash scripts/run_observability_native.sh
# The script prints the exact OTEL_HEADERS line (Basic auth) to paste below.
#
# Alternative backend - Aspire Dashboard via Docker:
#   bash scripts/run_observability.sh
#   OTEL_PROTOCOL=grpc
#   OTEL_ENDPOINT=http://localhost:4317
#   OTEL_HEADERS=
#   OTEL_UI_URL=http://localhost:18888
OTEL_ENABLED=true
OTEL_PROTOCOL=http
OTEL_ENDPOINT=http://localhost:5080/api/default
OTEL_HEADERS=
OTEL_SERVICE_NAME=insurance-rag-poc
OTEL_UI_URL=http://localhost:5080
