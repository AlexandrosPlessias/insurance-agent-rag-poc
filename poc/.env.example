# Copy to .env and adjust as needed. .env is gitignored.

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# --- Storage paths ---
# Relative paths below are anchored to poc/ by app/config.py, so they
# behave the same regardless of where Python is launched. Use absolute
# paths if you want to point at e.g. a shared NFS mount.
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=policies
SQLITE_PATH=./data/memory.sqlite

# --- Knowledge ingestion (Phase 6) ---
RAW_PDF_DIR=./data/knowledge_base/raw
PROCESSED_DIR=./data/knowledge_base/processed
METADATA_DIR=./data/knowledge_base/metadata
METADATA_SCHEMA_PATH=./data/knowledge_base/metadata/schema.json

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit ---
UI_API_URL=http://localhost:8000

# --- RAG tuning ---
# 1200 / 200 is the recommended sweet spot for structured policy PDFs:
# roomy enough for a full clause + context, precise enough for retrieval.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_K=5

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Observability (Phase 5) ---
# Targets Aspire Dashboard via OTLP gRPC. Start the backend with:
#   bash scripts/run_observability.sh   (or bash scripts/run_all.sh)
OTEL_ENABLED=true
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=insurance-rag-poc
OTEL_UI_URL=http://localhost:18888
