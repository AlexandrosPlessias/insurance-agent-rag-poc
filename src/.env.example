# Copy to src/.env and fill in values. src/.env is gitignored.
#
# Docker Compose is the only supported runtime (Phase 14+).
# All infrastructure URLs (Ollama, ChromaDB, inter-service) are baked into
# config.py defaults pointing at Docker service names — no overrides needed here.
#
# This file only needs secrets and optional tuning values.

# --- PostgreSQL ---
# Full connection string — replace <user> and <pass> with your chosen credentials.
# POSTGRES_USER and POSTGRES_PASSWORD below must match what you put in DATABASE_URL.
DATABASE_URL=postgresql://<user>:<pass>@postgres:5432/poc
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<pass>

# --- Model selection (optional — defaults match docker-compose.yml ollama-pull) ---
LLM_MODEL=qwen2.5:7b
PLANNER_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# --- HITL approval gates ---
# Change APPROVAL_HMAC_SECRET before any non-dev use.
APPROVAL_HMAC_SECRET=dev-insecure-secret-change-me
APPROVALS_KPI_THRESHOLD=1000000.0
# Telegram bot — leave blank to use UI-only approval (no Telegram notifications).
# Steps: open Telegram → @BotFather → /newbot → copy token.
# Get your chat_id: send any message to the bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage (optional overrides — defaults work with Docker volume mounts) ---
CHROMA_COLLECTION=policies
# Set to true to force a full ChromaDB wipe + re-index on next ingestion-service start.
# Reset to false (or remove) after the re-index completes.
FORCE_REINGEST=false

# --- RAG tuning (optional) ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_K=5

# --- Voice I/O (Phase 13 — enabled by default in Docker) ---
# STT model: tiny | small | medium | large-v3
VOICE_STT_MODEL=medium
VOICE_LANGUAGE=en
VOICE_TTS_VOICE=en_US-lessac-medium
VOICE_TTS_VOICE_EL=el_GR-rapunzelina-low
AUDIT_RETAIN_AUDIO=false

# --- Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=insurance-rag-poc
# OTel UI — accessed from the browser, always localhost
OTEL_UI_URL=http://localhost:18888

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
